{
  "manifest_version": 3,
  "name": "Habits Domain Journal",
  "version": "0.1.0",
  "description": "Logs visited hostnames and active-tab time to your local Habits SQLite collector.",
  "permissions": [
    "tabs",
    "webNavigation",
    "idle",
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Habits Domain Journal"
  }
}
